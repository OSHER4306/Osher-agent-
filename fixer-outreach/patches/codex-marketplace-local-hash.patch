+    #[test]
+    fn local_path_with_hash_is_not_treated_as_git_ref() {
+        let tempdir = TempDir::new().unwrap();
+        for name in ["folder#", "folder#one"] {
+            let dir = tempdir.path().join(name);
+            std::fs::create_dir(&dir).unwrap();
+            assert_eq!(
+                parse_marketplace_source(dir.to_str().unwrap(), None).unwrap(),
